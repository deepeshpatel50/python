#print positive and nagative element of a list
# 
# print positive and nagative element separately
# ignore zero
# example:
#input : [10,-5, 20, -3, 0, 8]
#output:
#positive: 10 20 8
#nagative: -5 -3

list = [10, -5, 20, -3, 0, 8]
print("positive :")
for element in list:
    if element > 0:
        print(f"{element}",end="")
print("negative :", end="")
for element in list:
    if element < 0:
        print(f"{element}")        


